# Production deployment env (ADR 0007). Copy to `.env` on the server and fill in
# real values. `docker-compose.prod.yml` reads it via `env_file` — never commit
# the filled-in `.env` (only this example is tracked).
#
# For LOCAL DEVELOPMENT you do NOT use this file. Dev only containerizes
# Postgres; the API reads apps/api/.env instead. See apps/api/.env.example.

# --- Postgres container (docker-compose.prod.yml `db` service) --------------
POSTGRES_USER="insuredesk"
POSTGRES_PASSWORD="change-me-to-a-strong-password"
POSTGRES_DB="insuredesk"

# --- API runtime (docker-compose.prod.yml `api` service) --------------------
# DATABASE_URL host is the compose SERVICE NAME `db` (not localhost): the API
# container reaches Postgres over the compose network. User/password/db must
# match the POSTGRES_* values above.
DATABASE_URL="postgresql://insuredesk:change-me-to-a-strong-password@db:5432/insuredesk?schema=public"

# Must be "production" — enables SPA static serving and secure cookies.
NODE_ENV="production"

# Session secret for signing cookies. Generate a long random string, e.g.:
#   openssl rand -hex 32
SESSION_SECRET="change-me-use-a-long-random-string-min-32-chars"

# --- First-install bootstrap (`pnpm db:bootstrap`) ---------------------------
# Initial admin account, read only by the bootstrap command (never by the
# server). Set before the first `db:bootstrap`; you can remove both lines once
# bootstrap has completed. Re-running bootstrap never touches existing users.
# ADMIN_USERNAME defaults to "admin".
ADMIN_INITIAL_PASSWORD="change-me-min-8-chars"
# ADMIN_USERNAME="admin"

# Optional overrides (sensible defaults baked into the image):
# HOST defaults to 0.0.0.0 (inside the container); compose binds it to
# 127.0.0.1:3000 on the host, so the API is never directly public.
# PORT defaults to 3000. LOG_LEVEL defaults to info.
# SESSION_MAX_AGE_SECONDS defaults to 86400 (24h).
# WEB_DIST_PATH defaults to /app/apps/web/dist in the image — leave unset.
# LOG_LEVEL="info"
# SESSION_MAX_AGE_SECONDS="86400"

# --- Build-time mirrors (restricted networks, e.g. mainland China) ----------
# Only used by `docker compose ... --build`. Default to official sources.
# Uncomment on a network where npmjs.org / binaries.prisma.sh are unreachable.
# NPM_REGISTRY="https://registry.npmmirror.com"
# PRISMA_ENGINES_MIRROR="https://registry.npmmirror.com/-/binary/prisma"
