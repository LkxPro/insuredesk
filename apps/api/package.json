{
  "name": "@insuredesk/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/routers/index.ts"
  },
  "scripts": {
    "dev": "tsx prisma/dev-init.ts && tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/multipart": "^10.1.0",
    "@fastify/static": "^10.1.0",
    "@insuredesk/shared": "workspace:*",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@trpc/server": "^11.0.0",
    "bcryptjs": "^3.0.3",
    "exceljs": "^4.4.0",
    "fastify": "^5.2.1",
    "pino": "^10.3.1",
    "prisma": "^7.8.0",
    "tsx": "^4.23.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.1.0",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^26.2.0",
    "pino-pretty": "^13.0.0",
    "testcontainers": "^12.1.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
