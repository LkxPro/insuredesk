# Copy to apps/api/.env and fill in real values for local development.
# The API validates these with Zod at startup (see src/env.ts); a missing or
# malformed value crashes the process. Prisma also reads this file.

# Postgres connection string used by Prisma and the API.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/insuredesk?schema=public"

# API server binding
HOST="0.0.0.0"
PORT="3000"

# One of: development | test | production
NODE_ENV="development"

# pino log level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL="info"
