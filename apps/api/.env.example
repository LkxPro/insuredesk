DATABASE_URL="postgresql://insuredesk:insuredesk_dev@localhost:5432/insuredesk?schema=public"

HOST="0.0.0.0"
PORT="3000"

NODE_ENV="development"

LOG_LEVEL="info"

SESSION_SECRET="change-me-in-production-use-a-long-random-string"

SESSION_MAX_AGE_SECONDS="86400"

# 骏伯保险平台对接（可选；缺省时推送应答 9999、回调投递空转，不拒启动）。
# JB_INSURANCE_PUSH_TOKEN="平台推送认证 token（按环境分发）"
# JB_INSURANCE_CALLBACK_URL="https://平台回调地址/api/work/order/callback"
# JB_INSURANCE_CALLBACK_SECRET="回调 AES secret（按环境分发）"

# 汇付 Webhook：密钥和商户号白名单均配置后启用。
# HUIFU_WEBHOOK_SECRET="32位字母数字，与汇付终端密钥一致"
# HUIFU_WEBHOOK_MERCHANT_IDS="商户汇付ID1,商户汇付ID2"
# HUIFU_WEBHOOK_SLA_POLICY_ID="可选，投诉种类下启用的策略ID；缺省不盖SLA"

# 开放数据 API（/api/v1）总开关，默认 false（整面 404）。只对字面 true 开启。
# OPEN_API_ENABLED="true"
