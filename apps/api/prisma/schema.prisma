// InsureDesk Prisma schema.
//
// Domain models arrive with the tickets that introduce them, each with its own
// migration.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================================
// Authentication & Authorization
// ============================================================================

/// User accounts with role-based access control.
/// Supports both password login (immediate) and future Feishu SSO (via feishuUserId).
model User {
  id           String    @id @default(cuid())
  username     String    @unique
  /// Hashed password (bcrypt). Nullable for future SSO-only accounts.
  passwordHash String?
  name         String    // Display name (e.g., "张三")
  email        String?   @unique
  /// For future Feishu SSO integration. Null for password-only accounts.
  feishuUserId String?   @unique
  /// Organizational label (not used for permissions this phase)
  team         String?
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now()) @db.Timestamptz
  updatedAt    DateTime  @updatedAt @db.Timestamptz

  roleId        String
  role          Role         @relation(fields: [roleId], references: [id])
  sessions      Session[]

  // 外部账号预填（内部账号恒为 null）：提交时服务端静默快照进工单字段。
  // 文本列的长度上限与对应工单字段一致，由 Zod 在 API 边界执法。
  /// 预填：反馈渠道引用; null = 未配置. 被预填引用的渠道只能停用不能删除 —
  /// Restrict is the DB backstop behind the service's refusal.
  prefillChannelId String?
  /// 预填：项目·保司
  prefillProject String?
  /// 预填：经纪主体
  prefillBrokerageEntity String?
  /// 预填：支付渠道
  prefillPaymentChannel String?
  /// 预填：用户投诉渠道
  prefillUserComplaintChannel String?
  /// 预填：投诉信息接收渠道
  prefillComplaintReceiveChannel String?
  /// 外部一级列表的有序字段配置（JSON 字符串数组）；null = 系统默认。
  externalListFields String?
  /// 外部详情／搜索／导出的有序字段配置（JSON 字符串数组）；null = 系统默认。
  externalDetailFields String?
  /// 外部用户个人一级列表列顺序；null = 跟随管理员／系统顺序。
  externalListOrder String?
  /// 外部用户个人 Excel/CSV 列顺序；null = 跟随管理员／系统顺序。
  externalExportOrder String?

  prefillChannel Channel? @relation(fields: [prefillChannelId], references: [id], onDelete: Restrict)

  /// Tickets currently assigned to this user (tickets.assigneeId)
  assignedTickets Ticket[] @relation("TicketAssignee")
  /// Tickets this user created (tickets.creatorId, creator-backed sources:
  /// manual 建单人 / file_import 导入者)
  createdTickets  Ticket[] @relation("TicketCreator")
  /// Import batches this user uploaded (ticket_import_batches.importerId)
  importBatches   TicketImportBatch[] @relation("TicketImportBatchImporter")
  /// Import batches this user revoked (ticket_import_batches.revokedById)
  revokedImportBatches TicketImportBatch[] @relation("TicketImportBatchRevoker")
  /// 轨 1 inbox notifications addressed to this user (issue #25)
  notifications   AppNotification[]
  schedules       Schedule[]
  externalTicketReadStates ExternalTicketReadState[]

  @@index([roleId])
  @@index([prefillChannelId])
  @@map("users")
}

/// 外部账号敏感字段授权／撤销审计。操作者与账号均存快照 id，不设外键，
/// 账号或人员后续变化不能抹去当时发生的授权事实。
model ExternalAccountFieldAudit {
  id              String   @id @default(cuid())
  targetAccountId String
  actorId         String
  actorName       String?
  grantedFields   String[] @default([])
  revokedFields   String[] @default([])
  at              DateTime @default(now()) @db.Timestamptz

  @@index([targetAccountId, at])
  @@index([actorId, at])
  @@map("external_account_field_audits")
}

/// 外部账号对客服公开回复的已读游标；只记录实际随详情成功加载到的最新回复时刻。
model ExternalTicketReadState {
  userId          String
  ticketId        String
  lastReadReplyAt DateTime @db.Timestamptz

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@id([userId, ticketId])
  @@index([ticketId])
  @@map("external_ticket_read_states")
}

/// 外部账号导出审计；筛选快照使用 JSON 字符串保存，避免后续字段增减改写历史。
model ExternalTicketExportAudit {
  id             String   @id @default(cuid())
  userId         String
  format         String
  filterSnapshot String
  fieldKeys      String[] @default([])
  rowCount       Int
  at             DateTime @default(now()) @db.Timestamptz

  @@index([userId, at])
  @@map("external_ticket_export_audits")
}

/// Roles define collections of permission points.
model Role {
  id          String   @id @default(cuid())
  name        String   @unique // e.g., "管理员", "一线客服"
  /// Flat array of permission-point strings (e.g., ["ticket.view", "ticket.view_all"])
  permissions String[] // Postgres text array
  /// 系统角色（仅管理员）：名称、权限、删除全锁
  system      Boolean  @default(false)
  /// 建单必填字段集（数组每项属于 TICKET_CREATE_FIELD_KEYS）；空 = 全非必填
  requiredTicketFields String[] @default([])
  createdAt   DateTime @default(now()) @db.Timestamptz
  updatedAt   DateTime @updatedAt @db.Timestamptz

  users User[]

  @@map("roles")
}

// ============================================================================
// Ticket domain (Issue #22)
// ============================================================================
//
// Enum-like columns (source, channel, category, complaintLevel, status, …) are
// plain String on purpose: their canonical values live in
// packages/shared/src/enums.ts (several are Chinese literals, which Prisma enums
// cannot express) and are enforced by Zod at the API boundary — one source of
// truth.

/// A customer-service work order — the system's core entity.
model Ticket {
  id String @id @default(cuid())

  /// Human-facing handle: 'WO' + global DB sequence. Generated by
  /// Postgres (concurrency-safe, gaps allowed, no year/month component).
  /// Plain concatenation, no lpad: the sequence starts at 100001 so values are
  /// always ≥6 digits, and lpad(…, 6) would TRUNCATE 7-digit values into
  /// colliding duplicates once the sequence passes 999999.
  /// The exact SQL default lives in migrations; keep this opaque to avoid
  /// Prisma treating equivalent Postgres-rendered expressions as schema drift.
  workOrderNumber String @unique @default(dbgenerated())

  createdAt    DateTime  @default(now()) @db.Timestamptz
  updatedAt    DateTime  @updatedAt @db.Timestamptz
  /// 客户实际反馈时间; null = 未填写 (issue #43)
  feedbackTime DateTime? @db.Timestamptz

  /// Entry method + "who created it" discriminator:
  /// feishu_form/manual/community/file_import
  source  String
  /// 反馈渠道目录引用; null = 未填写. Referenced rows can only be 停用, never
  /// deleted — Restrict is the DB backstop behind the service's refusal.
  channelId String?

  // 业务信息 — all nullable: unfilled means unknown (issue #43)
  project              String?
  brokerageEntity      String?
  paymentChannel       String?
  internalOrderNumber  String?
  /// 多值保单号；[] = 未填写（数组字段无 null 态）
  policyNumbers        String[] @default([])
  userComplaintChannel String?
  /// 投诉信息接收渠道（我方收到投诉的途径，区别于客户发起侧的用户投诉渠道）; null = 未填写
  complaintReceiveChannel String?

  // 客户信息 — all nullable: unfilled means unknown (issue #43)
  customerName      String?
  phone             String?
  contactPhone      String?
  customerRequest   String?
  /// 保司侧是否核身：是/否/待核实
  nuclearBodyStatus String?
  /// Tri-state: null = 未知, deliberately not false (issue #43)
  hasContacted      Boolean?
  /// 客户那次进线发生的时间; null = 未填写
  contactTime       DateTime? @db.Timestamptz
  contactId         String?

  // 分类与等级
  /// 客诉类别目录引用; null = 未填写. Referenced rows can only be 停用, never
  /// deleted — Restrict is the DB backstop behind the service's refusal.
  categoryId     String?
  /// The ONLY SLA driver — determines dueAt, 首响 and 跟进 requirements.
  /// null = 未定级: no dueAt, no 首响/跟进 requirements, no SLA time alerts
  /// until a later edit sets it (SLA then counts from the original createdAt).
  complaintLevel String?
  /// Independent free label (low/medium/high/urgent), default empty, no SLA role
  priority       String?
  /// 跟进频次要求, stamped from the level's SLA config; null while 未定级
  followUpFrequency        String?
  /// 首响要求, stamped from the level's SLA config; null while 未定级
  firstResponseRequirement String?

  // 处理状态 — only the 4 base statuses are stored;
  // pending_timeout/overdue are derived at read time
  status           String    @default("unassigned")
  assigneeId       String?
  /// First-assignment time, audit only — never used to compute dueAt
  assignedAt       DateTime? @db.Timestamptz
  /// Fixed at creation: createdAt + level's overdueHours; null for 特急
  dueAt            DateTime? @db.Timestamptz
  nextContactTime  DateTime? @db.Timestamptz
  /// Maintained solely by addComment (+1 per follow-up)
  contactCount     Int       @default(0)
  /// Latest follow-up remark, maintained solely by addComment
  processingResult String    @default("")

  // 完结信息
  completionTime   DateTime? @db.Timestamptz
  /// 完结状态目录引用; null = 未完结. Referenced rows can only be 停用, never
  /// deleted — Restrict is the DB backstop behind the service's refusal.
  completionStatusId String?
  /// Soft delete: non-null rows are excluded from default lists and statistics
  deletedAt        DateTime? @db.Timestamptz

  /// Creator (FK→User), set for creator-backed sources (manual 建单人 /
  /// file_import 导入者); external sources leave it null and "由谁创建"
  /// derives from source at read time
  creatorId String?

  /// 所属导入批次; null for every non-file_import ticket. The unit of 整批
  /// 撤销 — revoking a batch soft-deletes every ticket carrying its id.
  importBatchId String?

  /// 外部提交原文; source=external_channel 时必填，创建后不可编辑
  submissionText String?

  assignee         User?              @relation("TicketAssignee", fields: [assigneeId], references: [id])
  creator          User?              @relation("TicketCreator", fields: [creatorId], references: [id])
  category         TicketCategory?    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  channel          Channel?           @relation(fields: [channelId], references: [id], onDelete: Restrict)
  completionStatus CompletionStatus?  @relation(fields: [completionStatusId], references: [id], onDelete: Restrict)
  importBatch      TicketImportBatch? @relation(fields: [importBatchId], references: [id], onDelete: Restrict)
  processLogs      ProcessLog[]
  externalReadStates ExternalTicketReadState[]

  @@index([assigneeId])
  /// The non-view_all data scope ORs assigneeId with creatorId
  @@index([creatorId])
  @@index([categoryId])
  @@index([channelId])
  @@index([completionStatusId])
  @@index([status])
  @@index([createdAt])
  /// Computed-status predicates (pending_timeout/overdue) and 处理时限 sorting
  /// both range over dueAt
  @@index([dueAt])
  @@index([deletedAt])
  @@index([importBatchId])
  @@map("tickets")
}

/// One row per 批量导入上传 that reached the database — who imported, when,
/// how many rows, from which file. Doubles as the 撤销 unit: a clean batch
/// (no ticket processed or individually deleted) can be revoked whole —
/// every ticket soft-deleted and revokedAt/revokedById stamped here.
model TicketImportBatch {
  id         String   @id @default(cuid())
  importerId String
  importedAt DateTime @db.Timestamptz
  rowCount   Int
  /// Uploaded filename as the client sent it, for human recognition only.
  filename   String
  /// 整批撤销时刻; null = 未撤销. Set once — a revoked batch is final (no
  /// restore this phase) and can never be revoked again.
  revokedAt   DateTime? @db.Timestamptz
  revokedById String?

  importer  User     @relation("TicketImportBatchImporter", fields: [importerId], references: [id])
  revokedBy User?    @relation("TicketImportBatchRevoker", fields: [revokedById], references: [id])
  tickets   Ticket[]

  @@index([importerId])
  @@map("ticket_import_batches")
}

/// Audit log of every ticket operation; renders as the detail-page timeline.
/// Records "what was true at the time": operatorName is a
/// deliberate snapshot so renames/departures never rewrite history.
/// operatorId is intentionally NOT a foreign key for the same reason.
model ProcessLog {
  id             String   @id @default(cuid())
  ticketId       String
  operatorId     String
  /// Name snapshot at operation time
  operatorName   String?
  operatorAvatar String?
  /// create/assign/status_change/comment/upload/resolve/edit
  action         String
  /// Before-value; assign → name snapshot, status_change → status enum
  from           String?
  /// After-value; same conventions as `from`
  to             String?
  remark         String
  /// 仅内部可见标志; true = 外部查询时过滤
  internalOnly   Boolean  @default(false)
  at             DateTime @db.Timestamptz

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, at])
  @@map("process_logs")
}

/// SLA rule configuration, one row per complaint level. All
/// durations count from ticket createdAt.
model SlaPolicy {
  id                   String   @id @default(cuid())
  /// 一般投诉/高级投诉/加急投诉/特急投诉 — natural key, one row each
  complaintLevel       String   @unique
  /// 首响违约线 (minutes from createdAt); red-line threshold only, no counting
  firstResponseMinutes Int
  /// Overdue duration (hours from createdAt); null = no deadline (特急)
  overdueHours         Int?
  /// Typed ReminderRule[] (packages/shared/src/sla.ts), validated by Zod at
  /// every boundary
  reminderRules        Json
  createdAt            DateTime @default(now()) @db.Timestamptz
  updatedAt            DateTime @updatedAt @db.Timestamptz

  @@map("sla_policies")
}

// ============================================================================
// Ticket category catalog (Issue #68)
// ============================================================================

/// 管理员（dictionary.manage）维护的客诉类别目录。停用项退出新建/编辑下拉但
/// 保留存量引用；被引用的行不可物理删除。
model TicketCategory {
  id           String   @id @default(cuid())
  name         String   @unique
  active       Boolean  @default(true)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now()) @db.Timestamptz
  updatedAt    DateTime @updatedAt @db.Timestamptz

  tickets Ticket[]

  @@map("ticket_categories")
}

// ============================================================================
// Feedback channel catalog (Issue #69)
// ============================================================================

/// 管理员（dictionary.manage）维护的反馈渠道目录，生命周期语义与
/// TicketCategory 一致。
model Channel {
  id           String   @id @default(cuid())
  name         String   @unique
  active       Boolean  @default(true)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now()) @db.Timestamptz
  updatedAt    DateTime @updatedAt @db.Timestamptz

  tickets         Ticket[]
  prefillingUsers User[]

  @@map("channels")
}

// ============================================================================
// Completion status catalog (Issue #86)
// ============================================================================

/// 管理员（dictionary.manage）维护的完结状态目录，生命周期语义与
/// TicketCategory 一致。目录行由迁移插入（历史 12 项 + 存量脏值兜底），
/// 无应用层种子 —— 迁移即目录真相源。
model CompletionStatus {
  id           String   @id @default(cuid())
  name         String   @unique
  active       Boolean  @default(true)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now()) @db.Timestamptz
  updatedAt    DateTime @updatedAt @db.Timestamptz

  tickets Ticket[]

  @@map("completion_statuses")
}

// ============================================================================
// Shift definitions + schedule foundation (Issue #65)
// ============================================================================

/// 管理员配置的班次定义。segments 保存零个或多个墙钟时段；空数组表示休息日。
model ShiftType {
  id           String   @id @default(cuid())
  name         String   @unique
  color        String
  segments     Json
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now()) @db.Timestamptz
  updatedAt    DateTime @updatedAt @db.Timestamptz

  schedules Schedule[]

  @@map("shift_types")
}

/// 日期与班次时段均按墙钟字符串解释。
model Schedule {
  id      String @id @default(cuid())
  date    String
  userId  String
  shiftId String
  remark  String? @db.VarChar(200)
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  user  User      @relation(fields: [userId], references: [id])
  shift ShiftType @relation(fields: [shiftId], references: [id])

  @@unique([date, userId])
  @@index([date])
  @@map("schedules")
}

// ============================================================================
// Notifications (Issue #25)
// ============================================================================

/// 轨 1 收件箱: user-action-triggered TRUE events only —
/// this phase solely `assigned` (分配/改派). Written SYNCHRONOUSLY inside the
/// assignment transaction, no cron. Time-derived alerts (overdue/due_soon/待首响
/// …) are 轨 2 "我的待办": computed at read time, NEVER stored here.
model AppNotification {
  id    String @id @default(cuid())
  /// This phase only "assigned"; enum-like String per the schema-wide convention
  type  String
  title String
  /// Human-readable body; a 改派 notification annotates the remaining time
  content String

  /// Snapshot pointers to the ticket at event time — plain strings, no FK, so
  /// history survives whatever later happens to the ticket (same rationale as
  /// ProcessLog.operatorId)
  ticketId        String?
  workOrderNumber String?

  /// Recipient = the NEW assignee at event time
  targetUserId String
  read         Boolean  @default(false)
  createdAt    DateTime @default(now()) @db.Timestamptz

  targetUser User @relation(fields: [targetUserId], references: [id])

  /// Unread-count badge query
  @@index([targetUserId, read])
  /// Inbox listing, newest first
  @@index([targetUserId, createdAt])
  @@map("app_notifications")
}

/// Session storage for httpOnly cookie-based authentication.
/// Stored in Postgres (not Redis) this phase; sessions expire after inactivity.
model Session {
  id        String   @id @default(cuid())
  /// Session token stored in httpOnly cookie
  token     String   @unique
  userId    String
  expiresAt DateTime @db.Timestamptz
  createdAt DateTime @default(now()) @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
  @@map("sessions")
}
