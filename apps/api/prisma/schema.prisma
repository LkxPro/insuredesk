generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String?
  name         String
  email        String?  @unique
  feishuUserId String?  @unique
  team         String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @db.Timestamptz
  updatedAt    DateTime @updatedAt @db.Timestamptz

  roleId   String
  role     Role      @relation(fields: [roleId], references: [id])
  sessions Session[]

  // 外部账号预填（内部账号恒为 null）：提交时服务端静默快照进工单字段。
  // 文本列的长度上限与对应工单字段一致，由 Zod 在 API 边界执法。
  /// 预填：反馈渠道引用; null = 未配置. 被预填引用的渠道只能停用不能删除 —
  /// Restrict is the DB backstop behind the service's refusal.
  prefillChannelId                String?
  prefillProject                  String?
  prefillBrokerageEntity          String?
  prefillPaymentChannel           String?
  /// 预填：用户反馈渠道引用; null = 未配置. 被预填引用的目录项只能停用不能删除 —
  /// Restrict is the DB backstop behind the service's refusal.
  prefillUserFeedbackChannelId    String?
  /// 预填：反馈信息接收渠道引用; null = 未配置. Referenced rows can only be 停用,
  /// never deleted — Restrict is the DB backstop.
  prefillFeedbackReceiveChannelId String?

  prefillChannel                Channel?                @relation(fields: [prefillChannelId], references: [id], onDelete: Restrict)
  prefillUserFeedbackChannel    UserFeedbackChannel?    @relation(fields: [prefillUserFeedbackChannelId], references: [id], onDelete: Restrict)
  prefillFeedbackReceiveChannel FeedbackReceiveChannel? @relation(fields: [prefillFeedbackReceiveChannelId], references: [id], onDelete: Restrict)

  assignedTickets      Ticket[]            @relation("TicketAssignee")
  createdTickets       Ticket[]            @relation("TicketCreator")
  importBatches        TicketImportBatch[] @relation("TicketImportBatchImporter")
  revokedImportBatches TicketImportBatch[] @relation("TicketImportBatchRevoker")
  notifications        AppNotification[]
  schedules            Schedule[]
  apiKeys              ApiKey[]

  @@index([roleId])
  @@index([prefillChannelId])
  @@index([prefillUserFeedbackChannelId])
  @@index([prefillFeedbackReceiveChannelId])
  @@map("users")
}

model Role {
  id                   String   @id @default(cuid())
  name                 String   @unique
  permissions          String[]
  /// 系统角色（仅管理员）：名称、权限、删除全锁
  system               Boolean  @default(false)
  /// 建单必填字段集（数组每项属于 TICKET_CREATE_FIELD_KEYS）；空 = 全非必填
  requiredTicketFields String[] @default([])
  createdAt            DateTime @default(now()) @db.Timestamptz
  updatedAt            DateTime @updatedAt @db.Timestamptz

  users User[]

  @@map("roles")
}

// Enum-like columns (source, channel, category, status, …) are plain String on
// purpose: their canonical values live in packages/shared/src/enums.ts (several
// are Chinese literals, which Prisma enums cannot express) and are enforced by
// Zod at the API boundary — one source of truth.

model Ticket {
  id String @id @default(cuid())

  /// Human-facing handle: 'WO' + global DB sequence. Generated by
  /// Postgres (concurrency-safe, gaps allowed, no year/month component).
  /// Plain concatenation, no lpad: the sequence starts at 100001 so values are
  /// always ≥6 digits, and lpad(…, 6) would TRUNCATE 7-digit values into
  /// colliding duplicates once the sequence passes 999999.
  /// The exact SQL default lives in migrations; keep this opaque to avoid
  /// Prisma treating equivalent Postgres-rendered expressions as schema drift.
  workOrderNumber String @unique @default(dbgenerated())

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  source      String
  /// 工单种类目录引用（行为按种类 key 绑代码）. Referenced rows can only be
  /// 停用, never deleted — Restrict is the DB backstop.
  kindId      String
  /// SLA 计时锚盖章列：一切 SLA 计时（首响/检查点/超时）自它起算 —— 投诉单 =
  /// createdAt，退费异常单 = 平台推送的 refundCreateTime。建单时写入，此后不改。
  slaAnchorAt DateTime @db.Timestamptz

  contactPhone String?

  /// 时效策略目录引用; null = 未指定: no dueAt, no 首响/跟进 requirements, no
  /// SLA time alerts until a later edit sets it (SLA then counts from the
  /// original slaAnchorAt). Referenced rows can only be 停用, never deleted —
  /// Restrict is the DB backstop.
  slaPolicyId              String?
  /// 跟进频次要求, stamped from the level's SLA config; null while 未定级
  followUpFrequency        String?
  /// 首响要求, stamped from the level's SLA config; null while 未定级
  firstResponseRequirement String?

  // only the 4 base statuses are stored;
  // pending_timeout/overdue are derived at read time
  status          String    @default("unassigned")
  assigneeId      String?
  /// First-assignment time, audit only — never used to compute dueAt
  assignedAt      DateTime? @db.Timestamptz
  /// Fixed at creation: slaAnchorAt + level's overdueHours; null for 特急
  dueAt           DateTime? @db.Timestamptz
  nextContactTime DateTime? @db.Timestamptz
  /// Maintained solely by addComment (+1 per follow-up)
  contactCount    Int       @default(0)

  completionTime     DateTime? @db.Timestamptz
  /// 完结状态目录引用; null = 未完结. Referenced rows can only be 停用, never
  /// deleted — Restrict is the DB backstop behind the service's refusal.
  completionStatusId String?
  /// Soft delete: non-null rows are excluded from default lists and statistics
  deletedAt          DateTime? @db.Timestamptz

  /// Creator (FK→User), set for creator-backed sources (manual 建单人 /
  /// file_import 导入者); external sources leave it null and "由谁创建"
  /// derives from source at read time
  creatorId String?

  /// 所属导入批次; null for every non-file_import ticket. The unit of 整批
  /// 撤销 — revoking a batch soft-deletes every ticket carrying its id.
  importBatchId String?

  /// 外部提交原文; source=external_channel 时必填，创建后不可编辑
  submissionText String?

  assignee           User?                  @relation("TicketAssignee", fields: [assigneeId], references: [id])
  creator            User?                  @relation("TicketCreator", fields: [creatorId], references: [id])
  kind               TicketKind             @relation(fields: [kindId], references: [id], onDelete: Restrict)
  completionStatus   CompletionStatus?      @relation(fields: [completionStatusId], references: [id], onDelete: Restrict)
  slaPolicy          SlaPolicy?             @relation(fields: [slaPolicyId], references: [id], onDelete: Restrict)
  importBatch        TicketImportBatch?     @relation(fields: [importBatchId], references: [id], onDelete: Restrict)
  complaintDetail    TicketComplaintDetail?
  refundDetail       TicketRefundDetail?
  callbackDeliveries CallbackDelivery[]
  processLogs        ProcessLog[]

  @@index([assigneeId])
  /// The non-view_all data scope ORs assigneeId with creatorId
  @@index([creatorId])
  @@index([kindId])
  @@index([slaAnchorAt])
  @@index([completionStatusId])
  @@index([slaPolicyId])
  @@index([status])
  @@index([createdAt])
  /// Computed-status predicates (pending_timeout/overdue) and 处理时限 sorting
  /// both range over dueAt
  @@index([dueAt])
  @@index([deletedAt])
  @@index([importBatchId])
  /// 开放 API 全局增量流的游标序（(updatedAt, id) 翻页）
  @@index([updatedAt, id])
  @@map("tickets")
}

/// 投诉类工单（一切非 refund_exception 种类）的专属字段；退费单必无 detail
/// 行。存量投诉单可能缺行（防御），编辑路径 upsert 兜底补齐。
model TicketComplaintDetail {
  ticketId     String    @id
  feedbackTime DateTime? @db.Timestamptz

  /// 反馈渠道目录引用; null = 未填写. Referenced rows can only be 停用, never
  /// deleted — Restrict is the DB backstop behind the service's refusal.
  channelId String?

  // all nullable: unfilled means unknown
  project                  String?
  brokerageEntity          String?
  paymentChannel           String?
  internalOrderNumber      String?
  /// 多值保单号；[] = 未填写（数组字段无 null 态）
  policyNumbers            String[] @default([])
  /// true = 明确没有保单号（区别于未填写的 []）; true 时 policyNumbers 必为 []
  noPolicyNumber           Boolean  @default(false)
  /// 用户反馈渠道目录引用（客户发起侧）; null = 未填写. Referenced rows can only
  /// be 停用, never deleted — Restrict is the DB backstop behind the service's refusal.
  userFeedbackChannelId    String?
  /// 反馈信息接收渠道目录引用（我方收到反馈的途径，区别于客户发起侧的用户反馈渠道）;
  /// null = 未填写. Referenced rows can only be 停用, never deleted — Restrict is
  /// the DB backstop.
  feedbackReceiveChannelId String?

  // all nullable: unfilled means unknown
  customerName      String?
  phone             String?
  customerRequest   String?
  nuclearBodyStatus String?
  /// Tri-state: null = 未知, deliberately not false
  hasContacted      Boolean?
  contactTime       DateTime? @db.Timestamptz
  contactId         String?

  /// 客诉类别目录引用; null = 未填写. Referenced rows can only be 停用, never
  /// deleted — Restrict is the DB backstop behind the service's refusal.
  categoryId String?
  /// Independent free label (low/medium/high/urgent), default empty, no SLA role
  priority   String?

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  ticket                 Ticket                  @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  channel                Channel?                @relation(fields: [channelId], references: [id], onDelete: Restrict)
  category               TicketCategory?         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  userFeedbackChannel    UserFeedbackChannel?    @relation(fields: [userFeedbackChannelId], references: [id], onDelete: Restrict)
  feedbackReceiveChannel FeedbackReceiveChannel? @relation(fields: [feedbackReceiveChannelId], references: [id], onDelete: Restrict)

  @@index([channelId])
  @@index([categoryId])
  @@index([userFeedbackChannelId])
  @@index([feedbackReceiveChannelId])
  @@map("ticket_complaint_details")
}

/// One row per 批量导入上传 that reached the database — who imported, when,
/// how many rows, from which file. Doubles as the 撤销 unit: a clean batch
/// (no ticket processed or individually deleted) can be revoked whole —
/// every ticket soft-deleted and revokedAt/revokedById stamped here.
model TicketImportBatch {
  id          String    @id @default(cuid())
  importerId  String
  importedAt  DateTime  @db.Timestamptz
  rowCount    Int
  /// Uploaded filename as the client sent it, for human recognition only.
  filename    String
  /// 整批撤销时刻; null = 未撤销. Set once — a revoked batch is final (no
  /// restore) and can never be revoked again.
  revokedAt   DateTime? @db.Timestamptz
  revokedById String?

  importer  User     @relation("TicketImportBatchImporter", fields: [importerId], references: [id])
  revokedBy User?    @relation("TicketImportBatchRevoker", fields: [revokedById], references: [id])
  tickets   Ticket[]

  @@index([importerId])
  @@map("ticket_import_batches")
}

/// Audit log of every ticket operation; renders as the detail-page timeline.
/// Records "what was true at the time": operatorName is a
/// deliberate snapshot so renames/departures never rewrite history.
/// operatorId is intentionally NOT a foreign key for the same reason.
model ProcessLog {
  id             String   @id @default(cuid())
  ticketId       String
  operatorId     String
  operatorName   String?
  operatorAvatar String?
  action         String
  /// Before-value; assign → name snapshot, status_change → status enum
  from           String?
  /// After-value; same conventions as `from`
  to             String?
  remark         String
  /// 仅内部可见标志; true = 外部查询时过滤
  internalOnly   Boolean  @default(false)
  at             DateTime @db.Timestamptz

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, at])
  /// 开放 API 全局增量流的游标序（(at, id) 翻页）；(ticketId, at) 覆盖不了跨工单增量
  @@index([at, id])
  @@map("process_logs")
}

/// 时效策略目录实体 + SLA rule configuration. Tickets reference a row via
/// slaPolicyId; all durations count from ticket slaAnchorAt. Referenced rows are
/// never deleted — 停用 only.
model SlaPolicy {
  id                   String   @id @default(cuid())
  name                 String   @unique
  description          String?
  /// 组内目录序（组 = kindId 种类组）
  sortOrder            Int      @default(0)
  /// false = 停用：退出录入下拉/导入匹配/待办判定，存量引用照常显示
  active               Boolean  @default(true)
  /// 首响违约线 (minutes from slaAnchorAt); red-line threshold only, no counting
  firstResponseMinutes Int
  /// Overdue duration (hours from slaAnchorAt); null = no deadline
  overdueHours         Int?
  /// Typed ReminderRule[] (packages/shared/src/sla.ts), validated by Zod at
  /// every boundary
  reminderRules        Json
  /// 所属工单种类组. Referenced rows can only be 停用, never deleted —
  /// Restrict is the DB backstop.
  kindId               String
  createdAt            DateTime @default(now()) @db.Timestamptz
  updatedAt            DateTime @updatedAt @db.Timestamptz

  kind    TicketKind @relation(fields: [kindId], references: [id], onDelete: Restrict)
  tickets Ticket[]

  @@index([kindId])
  @@map("sla_policies")
}

/// 行为绑定行（种类携带的行为按稳定 key 由代码绑定）只启停、不物理删除、
/// key 不可改。
model TicketKind {
  id           String   @id @default(cuid())
  /// 行为绑定 key — 代码契约，创建后不可改；管理员新增的同形状行带随机 key
  key          String   @unique
  name         String   @unique
  active       Boolean  @default(true)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now()) @db.Timestamptz
  updatedAt    DateTime @updatedAt @db.Timestamptz

  tickets     Ticket[]
  slaPolicies SlaPolicy[]

  @@map("ticket_kinds")
}

/// 平台推送的实收清单，此后一律只读；金额一律 String 原样存取（系统不做数值
/// 运算）。(platform, endorNo) 是推送幂等键 —— 重复推送命中即返回首个工单。
model TicketRefundDetail {
  id                 String   @id @default(cuid())
  ticketId           String   @unique
  platform           String
  endorNo            String
  sysOrderId         String
  /// 纯展示文本，不做枚举校验 —— 平台新增类型不应被己方拒收
  workOrderType      String
  expectedAmount     String
  /// 平台推送的退费申请时刻；工单 slaAnchorAt 的盖章来源（可早于录入 12h）
  refundCreateTime   DateTime @db.Timestamptz
  /// 期次明细，平台推送原文
  refundTrades       Json
  holderName         String?
  holderPhone        String?
  companyName        String?
  productId          String?
  productName        String?
  policyNo           String?
  failureReason      String?
  /// 推送实收字段清单（合同字段名）——实收字段此后一律只读；缺省的可选字段
  /// 不在清单内，客服可后补
  pushedFields       String[] @default([])
  /// 补偿金（诚意金）; null = 无补偿。客服可编辑，完结后随回调载荷快照锁定
  compensationAmount String?
  createdAt          DateTime @default(now()) @db.Timestamptz
  updatedAt          DateTime @updatedAt @db.Timestamptz

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@unique([platform, endorNo])
  @@map("ticket_refund_details")
}

/// 完结事务内落行，载荷快照此后不变；at-least-once 投递（平台幂等吸收重复）。
/// 状态机 pending → delivered | dead：退避 5m→30m→2h，自首试 24h 或平台
/// 9998 转 dead 并告警管理员。
model CallbackDelivery {
  id       String @id @default(cuid())
  ticketId String
  /// pending | delivered | dead — 取值清单在 packages/shared/src/ticket-kind.ts
  status   String @default("pending")

  // 回调明文载荷快照（完结时刻锁定，此后一切字段不再回读工单）
  sysOrderId         String
  endorNo            String
  workOrderNumber    String
  actualAmount       String
  compensationAmount String?
  remark             String?
  operator           String?

  attempts       Int       @default(0)
  firstAttemptAt DateTime? @db.Timestamptz
  nextAttemptAt  DateTime? @db.Timestamptz
  lastError      String?
  deliveredAt    DateTime? @db.Timestamptz
  createdAt      DateTime  @default(now()) @db.Timestamptz
  updatedAt      DateTime  @updatedAt @db.Timestamptz

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt])
  @@index([ticketId])
  @@map("callback_deliveries")
}

/// 管理员（dictionary.manage）维护的客诉类别目录。停用项退出新建/编辑下拉但
/// 保留存量引用；被引用的行不可物理删除。
model TicketCategory {
  id           String   @id @default(cuid())
  name         String   @unique
  active       Boolean  @default(true)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now()) @db.Timestamptz
  updatedAt    DateTime @updatedAt @db.Timestamptz

  complaintDetails TicketComplaintDetail[]

  @@map("ticket_categories")
}

/// 管理员（dictionary.manage）维护的反馈渠道目录，生命周期语义与
/// TicketCategory 一致。
model Channel {
  id           String   @id @default(cuid())
  name         String   @unique
  active       Boolean  @default(true)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now()) @db.Timestamptz
  updatedAt    DateTime @updatedAt @db.Timestamptz

  complaintDetails TicketComplaintDetail[]
  prefillingUsers  User[]

  @@map("channels")
}

/// 管理员（dictionary.manage）维护的完结状态目录，生命周期语义与
/// TicketCategory 一致。目录行由迁移插入（历史 12 项 + 存量脏值兜底），
/// 无应用层种子 —— 迁移即目录真相源。
model CompletionStatus {
  id           String   @id @default(cuid())
  name         String   @unique
  active       Boolean  @default(true)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now()) @db.Timestamptz
  updatedAt    DateTime @updatedAt @db.Timestamptz

  tickets Ticket[]

  @@map("completion_statuses")
}

/// 管理员（dictionary.manage）维护的用户反馈渠道目录，生命周期语义与
/// TicketCategory 一致。目录行由迁移插入（映射表目标全集），
/// 无应用层种子 —— 迁移即目录真相源。
model UserFeedbackChannel {
  id           String   @id @default(cuid())
  name         String   @unique
  active       Boolean  @default(true)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now()) @db.Timestamptz
  updatedAt    DateTime @updatedAt @db.Timestamptz

  complaintDetails TicketComplaintDetail[]
  prefillingUsers  User[]

  @@map("user_feedback_channels")
}

/// 管理员（dictionary.manage）维护的反馈信息接收渠道目录，生命周期语义与
/// TicketCategory 一致。目录行由迁移插入（映射表目标全集），
/// 无应用层种子 —— 迁移即目录真相源。
model FeedbackReceiveChannel {
  id           String   @id @default(cuid())
  name         String   @unique
  active       Boolean  @default(true)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now()) @db.Timestamptz
  updatedAt    DateTime @updatedAt @db.Timestamptz

  complaintDetails TicketComplaintDetail[]
  prefillingUsers  User[]

  @@map("feedback_receive_channels")
}

/// 管理员配置的班次定义。segments 保存零个或多个墙钟时段；空数组表示休息日。
model ShiftType {
  id           String   @id @default(cuid())
  name         String   @unique
  color        String
  segments     Json
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now()) @db.Timestamptz
  updatedAt    DateTime @updatedAt @db.Timestamptz

  schedules Schedule[]

  @@map("shift_types")
}

/// 日期与班次时段均按墙钟字符串解释。
model Schedule {
  id        String   @id @default(cuid())
  date      String
  userId    String
  shiftId   String
  remark    String?  @db.VarChar(200)
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  user  User      @relation(fields: [userId], references: [id])
  shift ShiftType @relation(fields: [shiftId], references: [id])

  @@unique([date, userId])
  @@index([date])
  @@map("schedules")
}

/// 轨 1 收件箱: user-action-triggered TRUE events only —
/// solely `assigned` (分配/改派). Written SYNCHRONOUSLY inside the
/// assignment transaction, no cron. Time-derived alerts (overdue/due_soon/待首响
/// …) are 轨 2 "我的待办": computed at read time, NEVER stored here.
model AppNotification {
  id      String @id @default(cuid())
  type    String
  title   String
  /// Human-readable body; a 改派 notification annotates the remaining time
  content String

  /// Snapshot pointers to the ticket at event time — plain strings, no FK, so
  /// history survives whatever later happens to the ticket (same rationale as
  /// ProcessLog.operatorId)
  ticketId        String?
  workOrderNumber String?

  /// Recipient = the NEW assignee at event time
  targetUserId String
  read         Boolean  @default(false)
  createdAt    DateTime @default(now()) @db.Timestamptz

  targetUser User @relation(fields: [targetUserId], references: [id])

  /// Unread-count badge query
  @@index([targetUserId, read])
  /// Inbox listing, newest first
  @@index([targetUserId, createdAt])
  @@map("app_notifications")
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime @db.Timestamptz
  createdAt DateTime @default(now()) @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
  @@map("sessions")
}

/// 开放数据 API 的凭证。库内只存 sha256(keyHash) —— 明文仅创建时响应一次；
/// keyPreview 存明文后 8 位供列表辨认；expiresAt 可空：null = 永不过期。
/// status 取值在 packages/shared/src/open-api/api-keys.ts。
model ApiKey {
  id         String    @id @default(cuid())
  name       String
  keyHash    String    @unique
  keyPreview String
  userId     String
  expiresAt  DateTime? @db.Timestamptz
  lastUsedAt DateTime? @db.Timestamptz
  status     String    @default("active")
  createdAt  DateTime  @default(now()) @db.Timestamptz

  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessLogs ApiAccessLog[]

  @@index([userId])
  @@map("api_keys")
}

/// 开放数据 API 的访问审计。userId 是调用时刻的属主快照、不设 FK（与
/// ProcessLog.operatorId 同理：历史不随账号变更改写）。rowCount 含 tombstone
/// 行（软删工单照常计入返回条数）。
model ApiAccessLog {
  id         String   @id @default(cuid())
  keyId      String
  userId     String
  endpoint   String
  statusCode Int
  durationMs Int
  rowCount   Int
  ip         String
  requestId  String
  at         DateTime @db.Timestamptz

  key ApiKey @relation(fields: [keyId], references: [id], onDelete: Cascade)

  @@index([keyId, at])
  @@map("api_access_logs")
}

/// key 生命周期审计（create/revoke/revoke_all）。纯追加、不落任何 FK：吊销后
/// key 行仍在但属主账号可能被禁用/清理，审计不随对象存续而抹除。actorId/
/// targetUserId/keyName/keyPreview 均为动作时刻快照。
model ApiKeyAuditLog {
  id           String   @id @default(cuid())
  actorId      String
  action       String
  targetKeyId  String
  targetUserId String
  keyName      String
  keyPreview   String
  requestId    String?
  createdAt    DateTime @default(now()) @db.Timestamptz

  @@index([targetKeyId, createdAt])
  @@index([targetUserId, createdAt])
  @@map("api_key_audit_logs")
}
