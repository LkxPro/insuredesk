// InsureDesk Prisma schema.
//
// Domain models arrive with the tickets that introduce them, each with its own
// migration.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// Authentication & Authorization
// ============================================================================

/// User accounts with role-based access control.
/// Supports both password login (immediate) and future Feishu SSO (via feishuUserId).
model User {
  id           String    @id @default(cuid())
  username     String    @unique
  /// Hashed password (bcrypt). Nullable for future SSO-only accounts.
  passwordHash String?
  name         String    // Display name (e.g., "张三")
  email        String?   @unique
  /// For future Feishu SSO integration. Null for password-only accounts.
  feishuUserId String?   @unique
  /// Organizational label (not used for permissions this phase)
  team         String?
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now()) @db.Timestamptz
  updatedAt    DateTime  @updatedAt @db.Timestamptz

  roleId   String
  role     Role      @relation(fields: [roleId], references: [id])
  sessions Session[]

  /// Tickets currently assigned to this user (tickets.assigneeId)
  assignedTickets Ticket[] @relation("TicketAssignee")
  /// Tickets this user created manually (tickets.creatorId, source=manual only)
  createdTickets  Ticket[] @relation("TicketCreator")
  /// 轨 1 inbox notifications addressed to this user (issue #25)
  notifications   AppNotification[]
  schedules       Schedule[]

  @@index([roleId])
  @@map("users")
}

/// Roles define collections of permission points.
model Role {
  id          String   @id @default(cuid())
  name        String   @unique // e.g., "管理员", "一线客服"
  /// Flat array of permission-point strings (e.g., ["ticket.view", "ticket.view_all"])
  permissions String[] // Postgres text array
  /// 系统角色（仅管理员）：名称、权限、删除全锁
  system      Boolean  @default(false)
  /// 建单必填字段集（数组每项属于 TICKET_CREATE_FIELD_KEYS）；空 = 全非必填
  requiredTicketFields String[] @default([])
  createdAt   DateTime @default(now()) @db.Timestamptz
  updatedAt   DateTime @updatedAt @db.Timestamptz

  users User[]

  @@map("roles")
}

// ============================================================================
// Ticket domain (Issue #22)
// ============================================================================
//
// Enum-like columns (source, channel, category, complaintLevel, status, …) are
// plain String on purpose: their canonical values live in
// packages/shared/src/enums.ts (several are Chinese literals fixed by the PRD,
// which Prisma enums cannot express) and are enforced by Zod at the API
// boundary — one source of truth, no schema/PRD drift.

/// A customer-service work order — the system's core entity (PRD §3.1).
model Ticket {
  id String @id @default(cuid())

  /// Human-facing handle: 'WO' + global DB sequence (PRD §9.3). Generated by
  /// Postgres (concurrency-safe, gaps allowed, no year/month component).
  /// Plain concatenation, no lpad: the sequence starts at 100001 so values are
  /// always ≥6 digits, and lpad(…, 6) would TRUNCATE 7-digit values into
  /// colliding duplicates once the sequence passes 999999.
  /// The exact SQL default lives in migrations; keep this opaque to avoid
  /// Prisma treating equivalent Postgres-rendered expressions as schema drift.
  workOrderNumber String @unique @default(dbgenerated())

  createdAt    DateTime  @default(now()) @db.Timestamptz
  updatedAt    DateTime  @updatedAt @db.Timestamptz
  /// 客户实际反馈时间; null = 未填写 (issue #43)
  feedbackTime DateTime? @db.Timestamptz

  /// Entry method + "who created it" discriminator: feishu_form/manual/community
  source  String
  /// Business channel (保司/经纪/支付/监管); null = 未填写 (issue #43)
  channel String?

  // 业务信息 (PRD §3.1.3) — all nullable: unfilled means unknown (issue #43)
  project              String?
  brokerageEntity      String?
  paymentChannel       String?
  internalOrderNumber  String?
  policyNumber         String?
  userComplaintChannel String?

  // 客户信息 (PRD §3.1.4) — all nullable: unfilled means unknown (issue #43)
  customerName      String?
  phone             String?
  contactPhone      String?
  customerRequest   String?
  /// 保司侧是否核身：是/否/待核实
  nuclearBodyStatus String?
  /// Tri-state: null = 未知, deliberately not false (issue #43)
  hasContacted      Boolean?
  contactId         String?

  // 分类与等级 (PRD §3.1.5)
  category       String?
  /// The ONLY SLA driver — determines dueAt, 首响 and 跟进 requirements.
  /// null = 未定级: no dueAt, no 首响/跟进 requirements, no SLA time alerts
  /// until a later edit sets it (SLA then counts from the original createdAt).
  complaintLevel String?
  /// Independent free label (low/medium/high/urgent), default empty, no SLA role
  priority       String?
  /// 跟进频次要求, stamped from the level's SLA config; null while 未定级
  followUpFrequency        String?
  /// 首响要求, stamped from the level's SLA config; null while 未定级
  firstResponseRequirement String?

  // 处理状态 (PRD §3.1.6) — only the 4 base statuses are stored;
  // pending_timeout/overdue are derived at read time (ADR 0001)
  status           String    @default("unassigned")
  assigneeId       String?
  /// First-assignment time, audit only — never used to compute dueAt (ADR 0002)
  assignedAt       DateTime? @db.Timestamptz
  /// Fixed at creation: createdAt + level's overdueHours; null for 特急
  dueAt            DateTime? @db.Timestamptz
  nextContactTime  DateTime? @db.Timestamptz
  /// Maintained solely by addComment (+1 per follow-up)
  contactCount     Int       @default(0)
  /// Latest follow-up remark, maintained solely by addComment
  processingResult String    @default("")

  // 完结信息 (PRD §3.1.7)
  completionTime   DateTime? @db.Timestamptz
  completionStatus String?
  /// Soft delete: non-null rows are excluded from default lists and statistics
  deletedAt        DateTime? @db.Timestamptz

  /// Creator (FK→User), set ONLY when source=manual; external sources leave it
  /// null and "由谁创建" derives from source at read time (PRD §3.1.8)
  creatorId String?

  assignee    User?        @relation("TicketAssignee", fields: [assigneeId], references: [id])
  creator     User?        @relation("TicketCreator", fields: [creatorId], references: [id])
  processLogs ProcessLog[]

  @@index([assigneeId])
  @@index([status])
  @@index([createdAt])
  /// Computed-status predicates (pending_timeout/overdue) and 处理时限 sorting
  /// both range over dueAt (ADR 0001)
  @@index([dueAt])
  @@index([deletedAt])
  @@map("tickets")
}

/// Audit log of every ticket operation; renders as the detail-page timeline
/// (PRD §3.2). Records "what was true at the time": operatorName is a
/// deliberate snapshot so renames/departures never rewrite history.
/// operatorId is intentionally NOT a foreign key for the same reason.
model ProcessLog {
  id             String   @id @default(cuid())
  ticketId       String
  operatorId     String
  /// Name snapshot at operation time
  operatorName   String?
  operatorAvatar String?
  /// create/assign/status_change/comment/upload/resolve/edit
  action         String
  /// Before-value; assign → name snapshot, status_change → status enum (PRD §3.2)
  from           String?
  /// After-value; same conventions as `from`
  to             String?
  remark         String
  at             DateTime @db.Timestamptz

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, at])
  @@map("process_logs")
}

/// SLA rule configuration, one row per complaint level (PRD §3.8, ADR 0005).
/// Seeded with PRD defaults; admin editor arrives in a later ticket. All
/// durations count from ticket createdAt.
model SlaPolicy {
  id                   String   @id @default(cuid())
  /// 一般投诉/高级投诉/加急投诉/特急投诉 — natural key, one row each
  complaintLevel       String   @unique
  /// 首响违约线 (minutes from createdAt); red-line threshold only, no counting
  firstResponseMinutes Int
  /// Overdue duration (hours from createdAt); null = no deadline (特急)
  overdueHours         Int?
  /// Typed ReminderRule[] (packages/shared/src/sla.ts), validated by Zod at
  /// every boundary
  reminderRules        Json
  createdAt            DateTime @default(now()) @db.Timestamptz
  updatedAt            DateTime @updatedAt @db.Timestamptz

  @@map("sla_policies")
}

// ============================================================================
// Shift definitions + schedule foundation (Issue #65)
// ============================================================================

/// 管理员配置的班次定义。segments 保存零个或多个墙钟时段；空数组表示休息日。
model ShiftType {
  id           String   @id @default(cuid())
  name         String   @unique
  color        String
  segments     Json
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now()) @db.Timestamptz
  updatedAt    DateTime @updatedAt @db.Timestamptz

  schedules Schedule[]

  @@map("shift_types")
}

/// 日期与班次时段均按墙钟字符串解释。
model Schedule {
  id      String @id @default(cuid())
  date    String
  userId  String
  shiftId String
  remark  String? @db.VarChar(200)
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  user  User      @relation(fields: [userId], references: [id])
  shift ShiftType @relation(fields: [shiftId], references: [id])

  @@unique([date, userId])
  @@index([date])
  @@map("schedules")
}

// ============================================================================
// Notifications (Issue #25)
// ============================================================================

/// 轨 1 收件箱 (PRD §3.7, ADR 0004): user-action-triggered TRUE events only —
/// this phase solely `assigned` (分配/改派). Written SYNCHRONOUSLY inside the
/// assignment transaction, no cron. Time-derived alerts (overdue/due_soon/待首响
/// …) are 轨 2 "我的待办": computed at read time, NEVER stored here.
model AppNotification {
  id    String @id @default(cuid())
  /// This phase only "assigned"; enum-like String per the schema-wide convention
  type  String
  title String
  /// Human-readable body; a 改派 notification annotates the remaining time
  content String

  /// Snapshot pointers to the ticket at event time — plain strings, no FK, so
  /// history survives whatever later happens to the ticket (same rationale as
  /// ProcessLog.operatorId)
  ticketId        String?
  workOrderNumber String?

  /// Recipient = the NEW assignee at event time
  targetUserId String
  read         Boolean  @default(false)
  createdAt    DateTime @default(now()) @db.Timestamptz

  targetUser User @relation(fields: [targetUserId], references: [id])

  /// Unread-count badge query
  @@index([targetUserId, read])
  /// Inbox listing, newest first
  @@index([targetUserId, createdAt])
  @@map("app_notifications")
}

/// Session storage for httpOnly cookie-based authentication.
/// Stored in Postgres (not Redis) this phase; sessions expire after inactivity.
model Session {
  id        String   @id @default(cuid())
  /// Session token stored in httpOnly cookie
  token     String   @unique
  userId    String
  expiresAt DateTime @db.Timestamptz
  createdAt DateTime @default(now()) @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
  @@map("sessions")
}
