# 联调测试环境 env。复制为 `.env.test` 填真实值(不进版本库),compose 命令
# 一律带 `--env-file .env.test`。与 prod 的 `.env` 完全独立:凭证、secret、
# token 一律另起一套,绝不复用。

# --- Postgres 容器(docker-compose.test.yml `insuredesk-db-test`) ----------
TEST_POSTGRES_USER="insuredesk_test"
TEST_POSTGRES_PASSWORD="change-me-to-a-strong-password"
TEST_POSTGRES_DB="insuredesk_test"

# --- 测试镜像(docker-compose.test.yml `insuredesk-api-test`) --------------
# CI test 通道的可变 tag;要钉住某个历史构建用 test-<shortsha>。
TEST_IMAGE_TAG="test"

# --- API 运行时 -----------------------------------------------------------
# 主机名必须是 compose 服务名 `insuredesk-db-test`,不是 localhost;
# 账号密码与上面 TEST_POSTGRES_* 一致。
DATABASE_URL="postgresql://insuredesk_test:change-me-to-a-strong-password@insuredesk-db-test:5432/insuredesk_test?schema=public"

# Must be "production" — enables SPA static serving and secure cookies.
NODE_ENV="production"

# openssl rand -hex 32 生成,与 prod 不同的另一串。
SESSION_SECRET="change-me-use-a-long-random-string-min-32-chars"

# --- 构建镜像源(仅分支联调本地 build 逃生舱用) -----------------------------
# NPM_REGISTRY="https://registry.npmmirror.com"
# PRISMA_ENGINES_MIRROR="https://registry.npmmirror.com/-/binary/prisma"

# --- 骏伯保险平台对接(可选;缺省时推送应答 9999、回调投递空转,不拒启动) ---
# 测试环境独立凭证,勿复用生产值。
# JB_INSURANCE_PUSH_TOKEN="平台推送认证 token(测试环境独立)"
# JB_INSURANCE_CALLBACK_URL="https://骏伯测试回调地址/api/work/order/callback"
# JB_INSURANCE_CALLBACK_SECRET="回调 AES secret(测试环境独立)"
